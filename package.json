{
  "name": "transcriptout",
  "version": "0.1.0",
  "description": "Drop-in replacement for youtube-transcript that works from servers and clouds. Hosted by TranscriptOut, no proxies to run.",
  "license": "MIT",
  "author": "Artem Chuikin <support@transcriptout.com>",
  "homepage": "https://transcriptout.com",
  "repository": { "type": "git", "url": "git+https://github.com/artemchuikin/youtube-transcript-js.git" },
  "bugs": { "url": "https://github.com/artemchuikin/youtube-transcript-js/issues" },
  "keywords": ["youtube", "transcript", "captions", "subtitles", "youtube-transcript", "api"],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/esm/index.d.ts", "default": "./dist/cjs/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && mv dist/cjs/index.js dist/cjs/index.cjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
